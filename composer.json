{
    "name": "blutrixx/nativephp-mobile-updater",
    "version": "1.0.0",
    "description": "Self-hosted APK updater plugin for NativePHP Mobile",
    "type": "nativephp-plugin",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Blutrixx\\MobileUpdater\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Blutrixx\\MobileUpdater\\MobileUpdaterServiceProvider"
            ],
            "aliases": {
                "MobileUpdater": "Blutrixx\\MobileUpdater\\Facades\\MobileUpdater"
            }
        },
        "nativephp": {
            "manifest": "nativephp.json"
        }
    },
    "require": {
        "php": "^8.1"
    }
}
